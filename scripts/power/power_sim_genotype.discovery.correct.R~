library(fields)
library(parallel)

############################################################
## 1. Make allele-frequency grid
############################################################

make.p.grid <- function(ngrid, af.min = 1e-4) {
  seq(af.min, 1 - af.min, length.out = ngrid + 1)
}

############################################################
## 2. Power for one pair of allele frequencies
############################################################

compute.genotype.power.one <- function(n.pre,
                                       n.post,
                                       p.pre,
                                       p.post,
                                       sig = 1.1e-8,
                                       nsim = 10000,
                                       min.maf = 0.05) {
  
  combined.af <- (n.pre * p.pre + n.post * p.post) /
    (n.pre + n.post)
  
  combined.maf <- min(combined.af, 1 - combined.af)
  
  if (combined.maf < min.maf) {
    return(NA_real_)
  }
  
  pvals <- replicate(nsim, {
    
    g.pre <- rbinom(n.pre, size = 2, prob = p.pre)
    g.post <- rbinom(n.post, size = 2, prob = p.post)
    
    genotype <- c(g.pre, g.post)
    cohort <- c(rep(0, n.pre), rep(1, n.post))
    
    ## fit <- lm(genotype ~ cohort)
    ## summary(fit)$coefficients["cohort", "Pr(>|t|)"]
    ##fit = glm(cohort ~ genotype, family = binomial)
    ##summary(fit)$coefficients["genotype", "Pr(>|z|)"]
    fit <- lm(cohort ~ genotype)
    summary(fit)$coefficients["genotype", "Pr(>|t|)"]

  })
  
  mean(pvals < sig)
}

############################################################
## 3. Multiple-core power grid
############################################################

compute.genotype.power.grid.mc <- function(n.pre,
                                           n.post,
                                           sig = 1.1e-8,
                                           ngrid = 200,
                                           min.maf = 0.05,
                                           af.min = 1e-4,
                                           nsim = 10000,
                                           n.cores = max(1, detectCores() - 1),
                                           seed = 1) {
  
  p.grid <- make.p.grid(
    ngrid = ngrid,
    af.min = af.min
  )
  
  grid.df <- expand.grid(
    post.af = p.grid,
    pre.af = p.grid
  )
  
  cl <- makeCluster(n.cores)
  
  on.exit(stopCluster(cl), add = TRUE)
  
  ## Reproducible parallel random numbers
  clusterSetRNGStream(cl, iseed = seed)
  
  ## Export needed objects/functions to workers
  clusterExport(
    cl,
    varlist = c(
      "compute.genotype.power.one",
      "n.pre",
      "n.post",
      "sig",
      "min.maf",
      "nsim"
    ),
    envir = environment()
  )
  
  power.vec <- parLapply(
    cl,
    seq_len(nrow(grid.df)),
    function(i) {
      
      compute.genotype.power.one(
        n.pre = n.pre,
        n.post = n.post,
        p.pre = grid.df$pre.af[i],
        p.post = grid.df$post.af[i],
        sig = sig,
        nsim = nsim,
        min.maf = min.maf
      )
    }
  )
  
  power.vec <- unlist(power.vec)
  
  power.mat <- matrix(
    power.vec,
    nrow = length(p.grid),
    ncol = length(p.grid),
    byrow = FALSE
  )
  
  invisible(list(
    p.grid = p.grid,
    power.mat = power.mat,
    grid.df = grid.df,
    n.pre = n.pre,
    n.post = n.post,
    sig = sig,
    min.maf = min.maf,
    nsim = nsim,
    n.cores = n.cores
  ))
}

############################################################
## 4. Extract minimum detectable delta AF by pre-BD AF
############################################################

extract.min.delta.by.pre.af.genotype.mc <- function(n.pre,
                                                    n.post,
                                                    sig = 1.1e-8,
                                                    ngrid = 100,
                                                    target.power = 0.8,
                                                    min.maf = 0.05,
                                                    af.min = 1e-4,
                                                    nsim = 1000,
                                                    n.cores = max(1, detectCores() - 1),
                                                    seed = 1) {
  
  power.obj <- compute.genotype.power.grid.mc(
    n.pre = n.pre,
    n.post = n.post,
    sig = sig,
    ngrid = ngrid,
    min.maf = min.maf,
    af.min = af.min,
    nsim = nsim,
    n.cores = n.cores,
    seed = seed
  )
  
  p.grid <- power.obj$p.grid
  power.mat <- power.obj$power.mat
  
  grid.df <- expand.grid(
    post.af = p.grid,
    pre.af = p.grid
  )
  
  grid.df$power <- as.vector(power.mat)
  
  grid.df$combined.af <- with(
    grid.df,
    (n.pre * pre.af + n.post * post.af) / (n.pre + n.post)
  )
  
  grid.df$combined.maf <- pmin(
    grid.df$combined.af,
    1 - grid.df$combined.af
  )
  
  grid.df$delta.af <- abs(grid.df$post.af - grid.df$pre.af)
  
  powered.df <- grid.df[
    !is.na(grid.df$power) &
      grid.df$combined.maf >= min.maf &
      grid.df$power >= target.power,
  ]
  
  result <- do.call(
    rbind,
    lapply(p.grid, function(this.pre.af) {
      
      df <- powered.df[powered.df$pre.af == this.pre.af, ]
      
      if (nrow(df) == 0) {
        return(data.frame(
          pre.af = this.pre.af,
          min.delta.af = NA_real_,
          post.af.at.min.delta = NA_real_,
          direction = NA_character_,
          power = NA_real_,
          combined.maf = NA_real_
        ))
      }
      
      df.min <- df[which.min(df$delta.af), ]
      
      data.frame(
        pre.af = df.min$pre.af,
        min.delta.af = df.min$delta.af,
        post.af.at.min.delta = df.min$post.af,
        direction = ifelse(
          df.min$post.af > df.min$pre.af,
          "increase",
          "decrease"
        ),
        power = df.min$power,
        combined.maf = df.min$combined.maf
      )
    })
  )
  
  rownames(result) <- NULL
  
  invisible(list(
    result = result,
    power.obj = power.obj,
    powered.df = powered.df
  ))
}

############################################################
## 5. Plot contour using multiple-core result
############################################################

plot.genotype.power.contour.mc <- function(n.pre,
                                           n.post,
                                           sig = 1.1e-8,
                                           ngrid = 100,
                                           target.power = 0.8,
                                           min.maf = 0.05,
                                           af.min = 1e-4,
                                           nsim = 1000,
                                           n.cores = max(1, detectCores() - 1),
                                           seed = 1,
                                           show.mask = TRUE) {
  
  power.obj <- compute.genotype.power.grid.mc(
    n.pre = n.pre,
    n.post = n.post,
    sig = sig,
    ngrid = ngrid,
    min.maf = min.maf,
    af.min = af.min,
    nsim = nsim,
    n.cores = n.cores,
    seed = seed
  )
  
  p.grid <- power.obj$p.grid
  power.mat <- power.obj$power.mat
  
  mask.mat <- outer(
    p.grid,
    p.grid,
    Vectorize(function(p.post, p.pre) {
      
      combined.af <- (n.pre * p.pre + n.post * p.post) /
        (n.pre + n.post)
      
      combined.maf <- min(combined.af, 1 - combined.af)
      
      as.numeric(combined.maf < min.maf)
    })
  )
  
  plot(
    NA,
    xlim = range(p.grid),
    ylim = range(p.grid),
    xlab = "Present-day allele frequency",
    ylab = "Pre-BD allele frequency",
    main = paste0(
      "Genotype simulation power = ", target.power,
      ", combined MAF >= ", min.maf
    )
  )
  
  if (show.mask) {
    image(
      x = p.grid,
      y = p.grid,
      z = mask.mat,
      add = TRUE,
      col = c(NA, "grey85"),
      breaks = c(-0.5, 0.5, 1.5)
    )
  }
  
  contour(
    x = p.grid,
    y = p.grid,
    z = power.mat,
    levels = target.power,
    add = TRUE,
    lwd = 2,
    drawlabels = TRUE
  )
  
  abline(a = 0, b = 1, lty = 2)
  
  invisible(list(
    p.grid = p.grid,
    power.mat = power.mat,
    mask.mat = mask.mat,
    min.maf = min.maf
  ))
}



plot.contour.from.mc.obj <- function(mc.obj,
                                     n.pre,
                                     n.post,
                                     contour.levels = c(0.5, 0.6, 0.7, 0.8, 0.9, 0.999),
                                     min.maf = 0.05,
                                     show.mask = TRUE,
                                     xlab.txt = 'post-BD Allele Frequency',
                                     ylab.txt = 'pre-BD Allele Frequency',
                                     main.txt = 'Discovery Power: Meta pre-BD vs. post-BD') {

    p.grid <- mc.obj$power.obj$p.grid
    power.mat <- mc.obj$power.obj$power.mat

    ## Combined MAF mask
    mask.mat <- outer(
        p.grid,
        p.grid,
        Vectorize(function(p.post, p.pre) {

            combined.af <- (n.pre * p.pre + n.post * p.post) /
                (n.pre + n.post)

            combined.maf <- min(combined.af, 1 - combined.af)

            as.numeric(combined.maf < min.maf)
        })
    )

    plot(
        NA,
        xlim = range(p.grid),
        ylim = range(p.grid),
        xlab = xlab.txt,
        ylab = ylab.txt,
        main = main.txt
    )

    if (show.mask) {
        image(
            x = p.grid,
            y = p.grid,
            z = mask.mat,
            add = TRUE,
            col = c(NA, "dark gray"),
            breaks = c(-0.5, 0.5, 1.5)
        )
    }

    ## Draw all contours except 0.8 in black
    other.levels <- setdiff(contour.levels, 0.8)

    contour(
        x = p.grid,
        y = p.grid,
        z = power.mat,
        levels = other.levels,
        add = TRUE,
        lwd = 1.5,
        col = "black",
        drawlabels = TRUE
    )

    ## Highlight 0.8 power contour in red
    if (0.8 %in% contour.levels) {
        contour(
            x = p.grid,
            y = p.grid,
            z = power.mat,
            levels = 0.8,
            add = TRUE,
            lwd = 1.5,
            col = "red",
            drawlabels = TRUE
        )
    }

    abline(a = 0, b = 1, lty = 2)

    invisible(list(
        p.grid = p.grid,
        power.mat = power.mat,
        mask.mat = mask.mat
    ))
}

